[Unit]
Description=WiFi Watchdog - automatic network reconnection service
After=sys-subsystem-net-devices-wlan0.device fleet-shell.service
Wants=sys-subsystem-net-devices-wlan0.device

# Never stop trying to restart this service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/bin/bash -c 'exec "$(find /home/*/Desktop/3-SYSTEM/wifi-watchdog/wifi-watchdog.sh 2>/dev/null | head -1)"'
Restart=always
RestartSec=3
User=root

StartLimitBurst=0
WatchdogSec=300

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target