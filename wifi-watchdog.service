[Unit]
Description=WiFi Watchdog - automatic network reconnection service
After=sys-subsystem-net-devices-wlan0.device fleet-shell.service
Wants=sys-subsystem-net-devices-wlan0.device

# Never stop trying to restart this service
StartLimitIntervalSec=0

[Service]
# install.sh renders __WATCHDOG_DIR__ to the module's absolute path.
Type=simple
ExecStart=__WATCHDOG_DIR__/wifi-watchdog.sh
WorkingDirectory=__WATCHDOG_DIR__
Restart=always
RestartSec=3
User=root
NotifyAccess=main

StartLimitBurst=0
WatchdogSec=300

Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
